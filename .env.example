# NeonDB
DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

# NextAuth (Auth.js v5)
AUTH_SECRET="your-secret"
NEXTAUTH_SECRET="your-secret"
# Local: http://localhost:3000 | Production with SSL: https://lmsclasses.com (must match browser URL)
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Production (SSL): NEXTAUTH_URL="https://lmsclasses.com"

# Temporary: set on Hostinger to reset a user password via POST /api/bootstrap/reset-password
# Remove after use. Body: { "email": "...", "newPassword": "...", "secret": "..." }
# BOOTSTRAP_SECRET="change-me-then-remove"

# Email — Hostinger (recommended for info@lmsclasses.com)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@lmsclasses.com"
SMTP_PASS="your-email-account-password"
MAIL_FROM="LMS Platform <info@lmsclasses.com>"

# Optional fallback (if SMTP not set)
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="LMS Platform <info@lmsclasses.com>"

# Razorpay (required) — https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="your_secret_key"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
# Webhook secret from Razorpay Dashboard → Webhooks (URL: https://lmsclasses.com/api/payments/webhook)
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# App
NEXT_PUBLIC_APP_URL="https://lmsclasses.com"
NEXT_PUBLIC_APP_NAME="LMS Platform"

# Google Cloud Storage — private video bucket (signed URLs via /api/video)
# Service account needs roles/storage.objectViewer (or objectAdmin) on the bucket.
GCS_BUCKET_NAME="lmsclasses-videos"
#
# BEST for Hostinger (avoids broken PEM \\n): base64 of the entire service-account JSON file.
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\path\key.json"))
# Then paste the single line as:
# GCP_SERVICE_ACCOUNT_JSON_BASE64="eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii..."
GCP_SERVICE_ACCOUNT_JSON_BASE64=""
#
# OR paste JSON as one line / OR use separate fields (often breaks on Hostinger):
# GCP_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GCP_PROJECT_ID="your-gcp-project-id"
GCP_CLIENT_EMAIL="gcs-url-signer@your-project.iam.gserviceaccount.com"
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Optional: base64 of the PEM only
# GCP_PRIVATE_KEY_BASE64=""
# After Save → Restart / Redeploy the Node app.
# Apply CORS once: gsutil cors set scripts/gcs-cors.json gs://lmsclasses-videos

# Meta WhatsApp Cloud API (developers.facebook.com → App → WhatsApp → API Setup)
# Template name: live_class_link | Language: en | Category: UTILITY or MARKETING
#
# Body (create in Meta Business Manager — variables {{1}}–{{5}}):
#   Hello {{1}},
#
#   Your live class session has been scheduled. Please find the details below:
#
#   Class: {{2}}
#   Course: {{3}}
#   Batch: {{4}}
#   Date & Time: {{5}}
#
#   Tap the button below to join your class on time.
#
# Footer (optional): LMS Classes
# Button: Visit website — Dynamic — URL https://{{1}}  (Meta uses {{1}} for the button variable)
# Body: {{1}} first name | {{2}} class | {{3}} course | {{4}} batch | {{5}} schedule
# Button: meeting link host/path (no https://)
META_WHATSAPP_TOKEN="EAAxxxx..."
META_WHATSAPP_PHONE_NUMBER_ID="123456789012345"
META_WHATSAPP_TEMPLATE_NAME="live_class_link"
META_WHATSAPP_TEMPLATE_LANGUAGE="en_US"
META_WHATSAPP_COUNTRY_CODE="+91"
# META_WHATSAPP_API_VERSION="v21.0"

# Uploads — default: ./uploads next to server.js (wiped on every Hostinger Git/hbuild redeploy).
# For production, set UPLOADS_DIR to a folder OUTSIDE the app deploy dir (lowercase /home/, real username — NOT /HOME/USER/):
# UPLOADS_DIR="/home/u123456789/domains/lmsclasses.com/persistent-uploads"
# Do NOT point UPLOADS_DIR at .../nodejs/uploads — Hostinger rebuilds replace that folder.
# Wrong values are auto-corrected or ignored; app falls back to ./uploads.
# Subfolders: course-thumbnails, hr-logos, org-logos, certificates, certificate-backgrounds
# Served at: https://lmsclasses.com/uploads/course-thumbnails/...

# Widget enrollment — optional
# CRON_SECRET="..."  # Bearer token for GET /api/cron/widget-follow-up (delayed failed-payment emails)
# WIDGET_REPAY_SECRET="..."  # HMAC secret for /pay/[leadId] repayment links (defaults to NEXTAUTH_SECRET)
